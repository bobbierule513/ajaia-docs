{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "type": "service",
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "ajaia-docs"
      }
    }
  ],
  "services": {
    "ajaia-docs": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm ci --include=dev && npm run build"
    },
    "api": {
      "root": ".",
      "framework": "express",
      "entrypoint": "server/vercel.js"
    }
  }
}
